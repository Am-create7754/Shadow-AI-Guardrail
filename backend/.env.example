# Copy to backend/.env and fill in. Never commit the real .env file.
#
# Generate a key in PowerShell:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | test | production  (production refuses to start without keys)
GUARDRAIL_ENVIRONMENT=development

# HMAC key used to fingerprint detected values (>= 32 bytes). If unset in
# development an ephemeral per-process key is generated with a warning.
GUARDRAIL_FINGERPRINT_KEY=

# Optional overrides
# GUARDRAIL_POLICY_PATH=app/policy/default_policy.yaml
# GUARDRAIL_MAX_INPUT_CHARS=100000
