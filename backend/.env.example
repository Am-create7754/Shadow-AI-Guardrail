# Copy to backend/.env and fill in. Never commit the real .env file.
#
# Generate a key in PowerShell:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | test | production  (production refuses to start without keys)
GUARDRAIL_ENVIRONMENT=development

# HMAC key used to fingerprint detected values (>= 32 bytes). If unset in
# development an ephemeral per-process key is generated with a warning.
GUARDRAIL_FINGERPRINT_KEY=

# Optional overrides
# GUARDRAIL_POLICY_PATH=app/policy/default_policy.yaml
# GUARDRAIL_MAX_INPUT_CHARS=100000

# --- Database ---------------------------------------------------------------
# Default: SQLite in %LOCALAPPDATA%\guardrail\guardrail.db (outside the repo).
# GUARDRAIL_DATABASE_URL=sqlite+aiosqlite:///C:/path/to/guardrail.db

# --- Audit chain (see docs/AUDIT.md) -----------------------------------------
# HMAC key (>= 32 bytes, must differ from the fingerprint key). Required in
# production; generated once under GUARDRAIL_KEYS_DIR in development.
GUARDRAIL_AUDIT_KEY=
# Retired audit keys still accepted for verification (comma-separated).
# GUARDRAIL_AUDIT_PREVIOUS_KEYS=
# Ed25519 private key (PKCS#8 PEM) for signing checkpoints. Required in production;
# keep it off the application host where possible.
# GUARDRAIL_CHECKPOINT_KEY_PATH=C:/secure/checkpoint_ed25519.pem
# GUARDRAIL_CHECKPOINT_INTERVAL=100
# GUARDRAIL_KEYS_DIR=C:/Users/<you>/AppData/Local/guardrail/keys

# --- Gateway (see docs/API.md) -----------------------------------------------
# All required in production; generated once under GUARDRAIL_KEYS_DIR in
# development. Each must be >= 32 bytes and different from every other key.
GUARDRAIL_JWT_SECRET=
GUARDRAIL_API_KEY_PEPPER=
GUARDRAIL_DATA_KEY=
# GUARDRAIL_JWT_TTL_MINUTES=30
# GUARDRAIL_MAX_BODY_BYTES=1000000
# GUARDRAIL_RATE_LIMIT_PER_MINUTE=120
# GUARDRAIL_LOGIN_RATE_LIMIT_PER_MINUTE=10
# GUARDRAIL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GUARDRAIL_APPROVAL_TTL_MINUTES=1440

# --- AI provider ----------------------------------------------------------------
# mock   = built-in fake model, no key, no network (default; used by all tests)
# openai = any OpenAI-compatible API (OpenAI, Anthropic's compatibility endpoint,
#          a local Ollama server, ...). Requires https unless the URL is localhost.
# GUARDRAIL_PROVIDER=openai
# GUARDRAIL_PROVIDER_API_KEY=sk-...          (never commit; this file is git-ignored)
# GUARDRAIL_PROVIDER_BASE_URL=https://api.openai.com/v1
# Models clients may request (cost control); others are refused with 400.
# GUARDRAIL_PROVIDER_MODELS=gpt-4o-mini,gpt-4.1-mini,gpt-4.1-nano
# GUARDRAIL_PROVIDER_TIMEOUT_SECONDS=60
# GUARDRAIL_PROVIDER_MAX_RETRIES=2
# GUARDRAIL_PROVIDER_MAX_OUTPUT_CHARS=200000
# Local Ollama example (no key needed):
#   GUARDRAIL_PROVIDER_BASE_URL=http://localhost:11434/v1
#   GUARDRAIL_PROVIDER_MODELS=llama3.2
