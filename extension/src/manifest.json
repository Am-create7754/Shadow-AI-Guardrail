{
  "manifest_version": 3,
  "name": "Shadow AI Guardrail",
  "version": "0.6.0",
  "description": "Checks prompts typed into AI chat sites with your organisation's guardrail gateway before they are sent.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Shadow AI Guardrail", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "storage": { "managed_schema": "managed_schema.json" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
